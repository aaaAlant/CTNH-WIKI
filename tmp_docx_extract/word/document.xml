<?xml version="1.0" encoding="UTF-8" standalone="yes"?><w:document xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture" xmlns:wp="http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"><w:body><w:p><w:pPr><w:pStyle w:val="000013"/><w:jc w:val="left"/><w:rPr/></w:pPr><w:r><w:rPr/><w:t>可投入wiki的内容</w:t></w:r></w:p><w:p><w:pPr><w:rPr/></w:pPr></w:p><w:p><w:pPr><w:pStyle w:val="000002"/><w:rPr/></w:pPr><w:r><w:rPr/><w:t>科技模块</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="000003"/><w:rPr/></w:pPr><w:r><w:rPr/><w:t>机械动力（</w:t></w:r><w:r><w:rPr><w:b w:val="1"/></w:rPr><w:t>Create</w:t></w:r><w:r><w:rPr/><w:t>）</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="000004"/><w:rPr/></w:pPr><w:r><w:rPr/><w:t>简介：</w:t></w:r></w:p><w:p><w:pPr><w:jc w:val="center"/><w:rPr/></w:pPr><w:r><w:rPr/><w:t>整合包基于6.0+版本的机械动力，及诸多附属（经典改进、冶金学、电气时代、矿石开掘等），设计了独具特色的齿轮风格科技玩法与序列配方合成。（注：以下的图片中的配方如果可以直接显示出配方过程以及物品的话要优于直接贴图片上去）</w:t></w:r></w:p><w:p><w:pPr><w:jc w:val="center"/><w:rPr/></w:pPr><w:r><w:rPr/><w:t>部分配方展示</w:t></w:r></w:p><w:p><w:pPr><w:jc w:val="center"/><w:rPr/></w:pPr><w:r><w:rPr/><w:t>精密构件</w:t></w:r></w:p><w:p><w:pPr><w:jc w:val="center"/><w:rPr/></w:pPr><w:r><w:rPr/><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0"><wp:extent cx="5278120" cy="3421352"/><wp:effectExtent l="0" t="0" r="0" b="0"/><wp:docPr id="2" name="picture" descr="descript"/><wp:cNvGraphicFramePr/><a:graphic><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic><pic:nvPicPr><pic:cNvPr id="3" name="picture" descr="descript"/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill rotWithShape="1"><a:blip r:embed="rId4"/><a:stretch/></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="5278120" cy="3421352"/></a:xfrm><a:prstGeom prst="rect"><