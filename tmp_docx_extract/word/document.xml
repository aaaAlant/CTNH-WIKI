科技深度融合，锻造出了应力多方块结构</w:t></w:r></w:p><w:p><w:pPr><w:jc w:val="center"/><w:rPr/></w:pPr><w:r><w:rPr/><w:t>部分结构展示</w:t></w:r></w:p><w:p><w:pPr><w:jc w:val="center"/><w:rPr/></w:pPr><w:r><w:rPr/><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0"><wp:extent cx="5278120" cy="5243957"/><wp:effectExtent l="0" t="0" r="0" b="0"/><wp:docPr id="11" name="picture" descr="descript"/><wp:cNvGraphicFramePr/><a:graphic><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic><pic:nvPicPr><pic:cNvPr id="12" name="picture" descr="descript"/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill rotWithShape="1"><a:blip r:embed="rId7"/><a:stretch/></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="5278120" cy="5243957"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p><w:pPr><w:jc w:val="center"/><w:rPr/></w:pPr><w:r><w:rPr/><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0"><wp:extent cx="5278120" cy="5244122"/><wp:effectExtent l="0" t="0" r="0" b="0"/><wp:docPr id="14" name="picture" descr="descript"/><wp:cNvGraphicFramePr/><a:graphic><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic><pic:nvPicPr><pic:cNvPr id="15" name="picture" descr="descript"/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill rotWithShape="1"><a:blip r:embed="rId8"/><a:stretch/></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="5278120" cy="5244122"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p><w:pPr><w:jc w:val="center"/><w:rPr/></w:pPr><w:r><w:rPr/><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0"><wp:extent cx="5278120" cy="5192989"/><wp:effectExtent l="0" t="0" r="0" b="0"/><wp:docPr id="17" name="picture" descr="descript"/><wp:cNvGraphicFramePr/><a:graphic><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic><pic:nvPicPr><pic:cNvPr id="18" name="picture" descr="descript"/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill rotWithShape="1"><a:blip r:embed="rId9"/><a:stretch/></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="5278120" cy="5192989"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p><w:pPr><w:pStyle w:val="000003"/><w:rPr/></w:pPr><w:r><w:rPr/><w:t>格雷科技（</w:t></w:r><w:r><w:rPr><w:b w:val="1"/><w:u w:val="single"/><w:shd w:fill="ffffff"/></w:rPr><w:t>Gregtech</w:t></w:r><w:r><w:rPr/><w:t>）</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="000004"/><w:rPr/></w:pPr><w:r><w:rPr/><w:t>简介：</w:t></w:r></w:p><w:p><w:pPr><w:jc w:val="center"/><w:rPr/></w:pPr><w:r><w:rPr/><w:t>我们以格雷原本的十五级电压（LV~MAX）为基本重制、修改、扩容了原版的GTM内容，并且我们使用机械动力的特色内容将原本的蒸汽时代进行替换，让玩家前期的进程变得更加有趣与轻松（但并非易事）。</w:t></w:r></w:p><w:p><w:pPr><w:jc w:val="center"/><w:rPr/></w:pPr><w:r><w:rPr/><w:t>同时我们也融合了其他模组的风格，为其他模组制作了可自动化版本的融合风格的特色机器与结构（例——血肉重铸</w:t></w:r><w:r><w:rPr><w:shd w:fill="ffffff"/></w:rPr><w:t>Biomancy、植物魔法Botania等等</w:t></w:r><w:r><w:rPr/><w:t>）。</w:t></w:r></w:p><w:p><w:pPr><w:jc w:val="center"/><w:rPr/></w:pPr><w:r><w:rPr/><w:t>同时我们也对原版格雷流程进行了深度魔改，让整个流程变得更加有趣（这也并非易事）</w:t></w:r></w:p><w:p><w:pPr><w:jc w:val="center"/><w:rPr/></w:pPr><w:r><w:rPr/><w:t>部分特色产线展示</w:t></w:r></w:p><w:p><w:pPr><w:jc w:val="center"/><w:rPr/></w:pPr><w:r><w:rPr/><w:t>1、超级矿物处理</w:t></w:r></w:p><w:p><w:pPr><w:jc w:val="center"/><w:rPr/></w:pPr><w:r><w:rPr/><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0"><wp:extent cx="5278120" cy="1144173"/><wp:effectExtent l="0" t="0" r="0" b="0"/><wp:docPr id="20" name="picture" descr="descript"/><wp:cNvGraphicFramePr/><a:graphic><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic><pic:nvPicPr><pic:cNvPr id="21" name="picture" descr="descript"/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill rotWithShape="1"><a:blip r:embed="rId10"/><a:stretch/></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="5278120" cy="1144173"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p><w:pPr><w:jc w:val="center"/><w:rPr/></w:pPr><w:r><w:rPr/><w:t>2、幽匿电路产线</w:t></w:r></w:p><w:p><w:pPr><w:jc w:val="center"/><w:rPr/></w:pPr><w:r><w:rPr/><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0"><wp:extent cx="3952875" cy="2314575"/><wp:effectExtent l="0" t="0" r="0" b="0"/><wp:docPr id="23" name="picture" descr="descript"/><wp:cNvGraphicFramePr/><a:graphic><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic><pic:nvPicPr><pic:cNvPr id="24" name="picture" descr="descript"/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill rotWithShape="1"><a:blip r:embed="rId11"/><a:stretch/></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="3952875" cy="2314575"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p><w:pPr><w:pStyle w:val="000004"/><w:rPr/></w:pPr><w:r><w:rPr/><w:t>特色结构：</w:t></w:r></w:p><w:p><w:pPr><w:jc w:val="center"/><w:rPr/></w:pPr><w:r><w:rPr/><w:t>部分结构展示</w:t></w:r></w:p><w:p><w:pPr><w:jc w:val="center"/><w:rPr/></w:pPr><w:r><w:rPr/><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0"><wp:extent cx="5278120" cy="5226958"/><wp:effectExtent l="0" t="0" r="0" b="0"/><wp:docPr id="26" name="picture" descr="descript"/><wp:cNvGraphicFramePr/><a:graphic><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic><pic:nvPicPr><pic:cNvPr id="27" name="picture" descr="descript"/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill rotWithShape="1"><a:blip r:embed="rId12"/><a:stretch/></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="5278120" cy="5226958"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p><w:pPr><w:jc w:val="center"/><w:rPr/></w:pPr><w:r><w:rPr/><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0"><wp:extent cx="5278120" cy="5269551"/><wp:effectExtent l="0" t="0" r="0" b="0"/><wp:docPr id="29" name="picture" descr="descript"/><wp:cNvGraphicFramePr/><a:graphic><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic><pic:nvPicPr><pic:cNvPr id="30" name="picture" descr="descript"/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill rotWithShape="1"><a:blip r:embed="rId13"/><a:stretch/></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="5278120" cy="5269551"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p><w:pPr><w:jc w:val="center"/><w:rPr/></w:pPr><w:r><w:rPr/><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0"><wp:extent cx="5278120" cy="5261066"/><wp:effectExtent l="0" t="0" r="0" b="0"/><wp:docPr id="32" name="picture" descr="descript"/><wp:cNvGraphicFramePr/><a:graphic><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic><pic:nvPicPr><pic:cNvPr id="33" name="picture" descr="descript"/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill rotWithShape="1"><a:blip r:embed="rId14"/><a:stretch/></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="5278120" cy="5261066"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p><w:pPr><w:pStyle w:val="000002"/><w:rPr/></w:pPr><w:r><w:rPr/><w:t>魔法模块</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="000003"/><w:rPr/></w:pPr><w:r><w:rPr/><w:t>植物魔法（</w:t></w:r><w:r><w:rPr><w:shd w:fill="ffffff"/></w:rPr><w:t>Botania</w:t></w:r><w:r><w:rPr/><w:t>）</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="000004"/><w:rPr/></w:pPr><w:r><w:rPr/><w:t>简介：</w:t></w:r></w:p><w:p><w:pPr><w:jc w:val="center"/><w:rPr/></w:pPr><w:r><w:rPr/><w:t>我们对植物魔法的产能花做了一些修改与机制上的重构，还额外添加了神话植物学和自制的CTNH ManaMachines模组为其添加更多风味，并且以此为基础制作出了融合了格雷科技风格的自动化魔力机器，并且添加了天顶机器研究与究极魔力产线，旨在保留原有植物魔法风味的前提下添加更多其他（格雷）调味以完善整条植物魔法链路。部分配方展示泰拉钢锭在盖亚反应器中的反应</w:t></w:r></w:p><w:p><w:pPr><w:jc w:val="center"/><w:rPr/></w:pPr><w:r><w:rPr/><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0"><wp:extent cx="4924425" cy="6191250"/><wp:effectExtent l="0" t="0" r="0" b="0"/><wp:docPr id="35" name="picture" descr="descript"/><wp:cNvGraphicFramePr/><a:graphic><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic><pic:nvPicPr><pic:cNvPr id="36" name="picture" descr="descript"/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill rotWithShape="1"><a:blip r:embed="rId15"/><a:stretch/></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="4924425" cy="6191250"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p><w:pPr><w:jc w:val="center"/><w:rPr/></w:pPr><w:r><w:rPr/><w:t>特色的饰品配方</w:t></w:r></w:p><w:p><w:pPr><w:jc w:val="center"/><w:rPr/></w:pPr><w:r><w:rPr/><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0"><wp:extent cx="4067175" cy="5638800"/><wp:effectExtent l="0" t="0" r="0" b="0"/><wp:docPr id="38" name="picture" descr="descript"/><wp:cNvGraphicFramePr/><a:graphic><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic><pic:nvPicPr><pic:cNvPr id="39" name="picture" descr="descript"/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill rotWithShape="1"><a:blip r:embed="rId16"/><a:stretch/></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="4067175" cy="5638800"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p><w:pPr><w:jc w:val="center"/><w:rPr/></w:pPr><w:r><w:rPr/><w:t>特殊的电子元件</w:t></w:r></w:p><w:p><w:pPr><w:jc w:val=